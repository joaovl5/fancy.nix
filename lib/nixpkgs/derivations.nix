f: let
  pkgs = f._pkgs;
  lib = f._lib;
in rec {
  _runtime-shell = pkgs.runtimeShell;
  _default-file-header = {
    enable = true;
    text = ''
      DO NOT MODIFY THIS FILE!
      This file was auto-generated by Nix.
    '';
    chars-start = "# ";
    chars-end = "";
  };
  _mk-file-comment-line = chars-start: chars-end: line-text: (
    chars-start + line-text + chars-end
  );
  _mk-file-header-echo = header-args:
    f.when-str (header-args.enable or false)
    (
      header-args.text
      |> f.split-str "\n"
      |> map (
        _mk-file-comment-line
        header-args.chars-start
        header-args.chars-end
      )
      |> map (x: "echo " + (f.escape-shell-str x) + ";")
      |> f.merge-lines
    );
  _run-yj = {
    file-name,
    file-content,
    yj-args,
    # header comments
    file-header ? {},
    extra ? {
      build-inputs = [];
      pass-as-file = [];
      args = {};
    },
  }:
    run-cmd
    <| f.deep-merge (extra.args or {}) {
      inherit file-name;
      build-inputs = [pkgs.yj] ++ (extra.build-inputs or []);
      args.rawInput = builtins.toJSON file-content;
      pass-as-file = ["rawInput"] ++ (extra.pass-as-file or []);
      # bash
      text = ''
        {
          ${_mk-file-header-echo (_default-file-header // file-header)}
          yj ${yj-args} < $rawInputPath;
        } > $out
      '';
    };

  _write-with-yj = yj-args: {
    file-name,
    file-content,
    args ? {},
  }:
    _run-yj (f.deep-merge args {
      inherit
        file-name
        file-content
        yj-args
        ;
    });

  write-toml = _write-with-yj "-jt";
  write-yaml = _write-with-yj "-jy";
  write-json = {
    file-name,
    file-content,
    header-ok ? false,
    args ? {},
  }: let
    yj-args = "-jj -i";
  in
    _run-yj (f.deep-merge args {
      inherit
        file-name
        file-content
        yj-args
        ;
      file-header =
        if header-ok
        then {
          enable = true;
          chars-start = "// ";
          chars-end = "";
        }
        else {
          enable = false;
          chars-start = "";
          chars-end = "";
        };
    });

  mk-search-path = lib.makeSearchPath;
  mk-bin-path = lib.makeBinPath;
  get-exe = lib.getExe;
  get-exe' = lib.getExe';

  run-cmd = {
    file-name,
    text,
    build-inputs ? [],
    native-build-inputs ? [],
    pass-as-file ? [],
    args ? {},
  }:
    text
    |> pkgs.runCommand file-name ({
        nativeBuildInputs = native-build-inputs;
        buildInputs = build-inputs;
        passAsFile = pass-as-file;
      }
      // args);

  mk-shell-script = {
    name,
    text,
    bin ? true,
    runtime-deps ? [],
    runtime-envvars ? {},
    bash-options ? ["errexit" "nounset" "pipefail"],
    check-phase ? "",
    allow-substitution ? true,
    prefer-local-build ? false,
    inherit-path ? true,
  }:
    pkgs.writeTextFile ({
        inherit name;
        executable = true;
        allowSubstitutes = allow-substitution;
        preferLocalBuild = prefer-local-build;
        # bash
        checkPhase = ''
          runHook preCheck
          ${pkgs.stdenv.shellDryRun} "$target"
          ${check-phase}
          runHook postCheck
        '';
        text =
          [
            "#!${_runtime-shell}"
            (bash-options
              |> map (opt: "set -o ${opt}")
              |> f.merge-lines)
            (f.merge-lines
              <| f.attr-values
              <| f.map-attrs (k: v: ''
                ${f.to-shell-var k v}
                export ${k}
              '')
              <| runtime-envvars)
            (let
              script-path =
                [(mk-bin-path runtime-deps)]
                ++ f.when-list inherit-path ["$PATH"]
                |> f.filter (x: x != "")
                |> f.join ":";
              # bash
            in ''
              export PATH="${script-path}"
            '')
          ]
          |> f.filter (x: x != "")
          |> f.merge-lines
          |> (x: x + "${text}\n");
      }
      // f.when-attrs bin {
        destination = "/bin/${name}";
        meta.mainProgram = name;
      });
}
